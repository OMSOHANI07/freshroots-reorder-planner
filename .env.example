# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_THINKING_LEVEL=low
# Neon Postgres (pooled connection string)
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=require
# Zoho Inventory PO sync (see docs/ZOHO_SETUP.md). POs are created only after Raghav approves.
ZOHO_SYNC_ENABLED=false
ZOHO_DC=in
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORGANIZATION_ID=
# true = mark each PO as Issued in Zoho after creating it (default: leave as Draft)
ZOHO_MARK_ISSUED=false
APP_TIMEZONE=Asia/Kolkata
# Printed on every PO header
COMPANY_NAME=Freshroots
COMPANY_ADDRESS=
