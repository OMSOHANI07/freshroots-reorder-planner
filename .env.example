# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_THINKING_LEVEL=low
# Neon Postgres (pooled connection string)
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=require
# ERPNext PO sync (see docs/ERPNEXT_SETUP.md). POs are created only after Raghav approves.
ERP_SYNC_ENABLED=false
ERPNEXT_URL=https://your-site.frappe.cloud
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=
# Company name exactly as in ERPNext (Setup > Company)
ERPNEXT_COMPANY=
# Optional target warehouse, exactly as in ERPNext (e.g. "Pune Central Warehouse - FR")
ERPNEXT_WAREHOUSE=
# true = submit each PO after creating it (default: leave as Draft for procurement)
ERPNEXT_SUBMIT=false
APP_TIMEZONE=Asia/Kolkata
# Printed on every PO header
COMPANY_NAME=Freshroots
COMPANY_ADDRESS=
